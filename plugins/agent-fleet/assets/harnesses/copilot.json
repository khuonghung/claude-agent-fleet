{
  "id": "copilot",
  "title": "GitHub Copilot CLI",
  "command": "copilot",
  "check": ["--version"],
  "docs": [
    "https://docs.github.com/en/copilot/reference/copilot-cli-reference/cli-programmatic-reference",
    "https://docs.github.com/en/copilot/reference/hooks-reference"
  ],
  "notes": "A starting point from `copilot --help` 1.0.63: prove it with `fleet harness check copilot --live` before a fleet uses it. Piped stdin runs one non-interactive turn (with -p the pipe is ignored). The runner chooses the session id. Output tokens come from the session's events file, where session.shutdown carries the session's running total.",
  "instructions": "AGENTS.md, CLAUDE.md and .github/copilot-instructions.md, read by the CLI itself",
  "prompt": "stdin",
  "sessionId": "set",
  "run": [
    "--session-id", "{sessionId}",
    ["--name", "{name}"],
    ["--model", "{model}"],
    ["--effort", "{effort}"],
    "--allow-all-tools", "--no-ask-user", "--no-auto-update",
    "--add-dir", "{boardDir}",
    "--deny-tool", "shell(git push)",
    "--output-format", "json"
  ],
  "resume": [
    "--resume={sessionId}",
    ["--model", "{model}"],
    ["--effort", "{effort}"],
    "--allow-all-tools", "--no-ask-user", "--no-auto-update",
    "--add-dir", "{boardDir}",
    "--deny-tool", "shell(git push)",
    "--output-format", "json"
  ],
  "output": "jsonl",
  "usage": {
    "file": "~/.copilot/session-state/{sessionId}/events.jsonl",
    "match": { "type": "session.shutdown" },
    "output": "data.tokenDetails.output.tokenCount",
    "cumulative": true
  },
  "reply": { "match": { "type": "assistant.message" }, "text": "data.content" }
}
